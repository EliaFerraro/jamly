{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint *)",
      "Bash(npm test *)",
      "Bash(npm run format)",
      "Bash(npx jest *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx prettier *)"
    ],
    "ask": ["Edit(./.github/workflows/**)", "Edit(./supabase/config.toml)", "Edit(./eas.json)"],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push * HEAD)",
      "Bash(git push * HEAD *)",
      "Bash(git push * dev)",
      "Bash(git push * dev *)",
      "Bash(git push *:dev)",
      "Bash(git push *:dev *)",
      "Bash(git push */dev)",
      "Bash(git push */dev *)",
      "Bash(git push *+dev)",
      "Bash(git push *+dev *)",
      "Bash(git push * staging)",
      "Bash(git push * staging *)",
      "Bash(git push *:staging)",
      "Bash(git push *:staging *)",
      "Bash(git push */staging)",
      "Bash(git push */staging *)",
      "Bash(git push *+staging)",
      "Bash(git push *+staging *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push */main)",
      "Bash(git push */main *)",
      "Bash(git push *+main)",
      "Bash(git push *+main *)",
      "Bash(npx supabase db push *)",
      "Bash(npx supabase db reset *)",
      "Bash(npx supabase config push *)",
      "Bash(npx supabase link *)",
      "Bash(supabase db push *)",
      "Bash(supabase db reset *)",
      "Bash(supabase config push *)",
      "Bash(supabase link *)",
      "Bash(eas build *)",
      "Bash(eas submit *)",
      "Bash(npx eas *)",
      "Bash(rm -rf *)"
    ]
  }
}
