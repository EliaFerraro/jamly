# Jamly — environment variables
#
# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API). `.env` is git-ignored and must never be committed.
#
# Only the ANON key belongs in the client. It is safe to ship precisely because
# row-level security does the real authorization work — see docs/tech/32-data-model.md.
# The SERVICE ROLE key must never appear in this app, in any environment.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The app runs without these set: it starts, navigates and renders the whole
# skeleton offline. Only network-backed features need a real project.
