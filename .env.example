# Jamly — environment variables
#
# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API Keys). `.env` is git-ignored and must never be
# committed.
#
# There is no local Supabase stack: every environment — simulator, phone, web —
# talks to the hosted project. That is why no LAN IP or 10.0.2.2 juggling
# appears anywhere in this repo.
#
# Only the PUBLISHABLE key belongs in the client. It is safe to ship precisely
# because row-level security does the real authorization work. The SECRET key
# (sb_secret_...) must never appear in this app, in any environment.
#
# Expo reads .env at dev-server startup only — restart after editing.
# EAS builds do NOT read this file: set the same two values as EAS environment
# variables before building.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# The app runs without these set: it starts and renders, and the connection
# screen reports "Not configured" rather than crashing.
